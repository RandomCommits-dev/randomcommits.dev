---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CommitGenerator from '../components/CommitGenerator.tsx';

const repos = (await getCollection('repos')).sort(
	(a, b) => +new Date(b.data.updatedAt) - +new Date(a.data.updatedAt),
);

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestNotes = notes.slice(0, 3);

const categories = [
	{ label: 'Flagship', test: (n: string) => !/^(lab|template|study)-/.test(n) },
	{ label: 'Experiments', test: (n: string) => n.startsWith('lab-') },
	{ label: 'Templates', test: (n: string) => n.startsWith('template-') },
	{ label: 'Learning', test: (n: string) => n.startsWith('study-') },
];

const grouped = categories
	.map((c) => ({ ...c, repos: repos.filter((r) => c.test(r.data.name)) }))
	.filter((g) => g.repos.length > 0);

const featured = grouped[0];
const rest = grouped.slice(1);

const tones = ['', 'tone-b', 'tone-c', 'tone-d'] as const;

const monogram = (name: string) => {
	const clean = name.replace(/^(lab|template|study)-/, '');
	return clean.slice(0, 1).toUpperCase();
};

const fallback = [
	{ name: 'Flagship projects', desc: 'Built to last. The ones we are proud of.', tag: 'no prefix' },
	{ name: 'lab-*', desc: 'Experiments and vibe-coding sessions.', tag: 'experiment' },
	{ name: 'template-*', desc: 'Starter templates we reach for.', tag: 'template' },
	{ name: 'study-*', desc: 'Learning in public.', tag: 'study' },
];
---

<BaseLayout>
	<section class="hero">
		<h1>randomcommits</h1>
		<p class="lede">
			A digital garden for random, vibe-driven coding projects. Some things
			here are polished. Some are half-finished sketches. All of them are
			commits we felt like making.
		</p>
		<CommitGenerator client:load />
	</section>

	{latestNotes.length > 0 && (
		<section class="grid-section latest-section">
			<div class="section-header">
				<h2>Latest from the garden</h2>
				<a class="section-link" href="/garden">View all notes →</a>
			</div>
			<div class="grid">
				{latestNotes.map((note) => (
					<a class="tile" href={`/garden/${note.id}/`}>
						<h3>{note.data.title}</h3>
						<p>{note.data.description ?? 'A note from the garden.'}</p>
					</a>
				))}
			</div>
		</section>
	)}

	{repos.length > 0 ? (
		<>
			{featured && (
				<section class="grid-section">
					<div class="section-head">
						<h2>Featured</h2>
					</div>
					<div class="story-grid">
						{featured.repos.map((r, i) => (
							<a class="story-row" href={r.data.homepage || r.data.url}>
								<div class:list={['story-thumb', tones[i % tones.length]]}>
									{monogram(r.data.name)}
								</div>
								<div class="story-body">
									<h3>{r.data.name}</h3>
									<p>{r.data.description || 'No description yet.'}</p>
									<div class="story-meta">
										{r.data.language && <span class="badge">{r.data.language}</span>}
										{r.data.stars > 0 && <span>★ {r.data.stars}</span>}
										<span class="badge">{featured.label}</span>
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			{rest.map((group) => (
				<section class="grid-section">
					<div class="section-head">
						<h2>{group.label}</h2>
					</div>
					<div class="story-grid">
						{group.repos.map((r, i) => (
							<a class="story-row" href={r.data.homepage || r.data.url}>
								<div class:list={['story-thumb', tones[i % tones.length]]}>
									{monogram(r.data.name)}
								</div>
								<div class="story-body">
									<h3>{r.data.name}</h3>
									<p>{r.data.description || 'No description yet.'}</p>
									<div class="story-meta">
										{r.data.language && <span class="badge">{r.data.language}</span>}
										{r.data.stars > 0 && <span>★ {r.data.stars}</span>}
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			))}
		</>
	) : (
		<section class="grid-section">
			<div class="section-head">
				<h2>What you will find</h2>
			</div>
			<div class="story-grid">
				{fallback.map((p, i) => (
					<article class="story-row">
						<div class:list={['story-thumb', tones[i % tones.length]]}>
							{p.name.slice(0, 1)}
						</div>
						<div class="story-body">
							<h3>{p.name}</h3>
							<p>{p.desc}</p>
							<div class="story-meta">
								<span class="badge">{p.tag}</span>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>
	)}
</BaseLayout>
