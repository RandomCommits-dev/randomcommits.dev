---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections } from '../data/lab-sections';
import { liveTools } from '../data/live-tools';
import { ideaHref } from '../lib/lab-links';

const total = sections.reduce((n, s) => n + s.ideas.length, 0);
---

<BaseLayout
	title="Coming soon · randomcommits.dev"
	description="A roadmap of security-flavored, vibe-driven coding projects coming soon to randomcommits.dev."
>
	<p class="eyebrow">🧪 the lab</p>
	<h1>Coming soon</h1>
	<p class="lede">
		{total} security-flavored, vibe-driven projects planned for the garden. Most
		are privacy-first tools that run entirely in your browser. Nothing phones
		home. Tended at random, shipped when the vibe is right.
	</p>

	<section class="grid-section">
		<h2>Live in the garden</h2>
		<p class="section-blurb">
			These browser tools are already shipped as interactive garden notes. Try them
			in your browser: nothing you paste is sent anywhere.
		</p>
		<div class="grid">
			{liveTools.map((tool) => (
				<a class="tile" href={tool.gardenHref}>
					<div class="idea-head">
						<h3>{tool.repo}</h3>
						<span class="live-badge">live</span>
					</div>
					<p>{tool.description}</p>
					<span class="badge">browser · garden note</span>
				</a>
			))}
		</div>
	</section>

	{sections.map((section) => (
		<section class="grid-section">
			<h2>{section.title}</h2>
			<p class="section-blurb">{section.blurb}</p>
			<div class="grid">
				{section.ideas.map((idea) => (
					<a
						class="tile"
						href={ideaHref(idea)}
						target="_blank"
						rel="noopener noreferrer"
					>
						<div class="idea-head">
							<h3>{idea.repo}</h3>
							<span class="soon-badge">soon</span>
						</div>
						<p>{idea.desc}</p>
						<span class="badge">{idea.type}</span>
					</a>
				))}
			</div>
		</section>
	))}

	<style>
		.section-blurb {
			color: var(--muted);
			margin: -0.75rem 0 1.5rem;
			max-width: 65ch;
		}

		.idea-head {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 0.75rem;
			margin-bottom: 0.5rem;
		}

		.idea-head h3 {
			margin: 0;
		}

		.soon-badge {
			flex-shrink: 0;
			font-size: 0.65rem;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: #d29922;
			background: rgba(210, 153, 34, 0.14);
			border: 1px solid rgba(210, 153, 34, 0.35);
			border-radius: 999px;
			padding: 0.1rem 0.55rem;
		}

		.live-badge {
			flex-shrink: 0;
			font-size: 0.65rem;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--accent);
			background: var(--accent-soft);
			border: 1px solid rgba(63, 185, 80, 0.35);
			border-radius: 999px;
			padding: 0.1rem 0.55rem;
		}
	</style>
</BaseLayout>
