---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections } from '../data/lab-sections';
import { liveTools } from '../data/live-tools';
import { ideaHref } from '../lib/lab-links';

const total = sections.reduce((n, s) => n + s.ideas.length, 0);

const tones = ['', 'tone-b', 'tone-c', 'tone-d'] as const;

const monogram = (name: string) => {
	const clean = name.replace(/^(lab|template|study)-/, '');
	return clean.slice(0, 1).toUpperCase();
};
---

<BaseLayout
	title="Coming soon · randomcommits.dev"
	description="A roadmap of security-flavored, vibe-driven coding projects coming soon to randomcommits.dev."
>
	<section class="hero">
		<p class="eyebrow">The lab</p>
		<h1>Coming soon</h1>
		<p class="lede">
			{total} security-flavored, vibe-driven projects planned for the garden. Most
			are privacy-first tools that run entirely in your browser. Nothing phones
			home. Tended at random, shipped when the vibe is right.
		</p>
	</section>

	<section class="grid-section">
		<div class="section-head">
			<h2>Live in the garden</h2>
		</div>
		<p class="section-blurb">
			These browser tools are already shipped as interactive garden notes. Try them
			in your browser: nothing you paste is sent anywhere.
		</p>
		<div class="story-grid">
			{liveTools.map((tool, i) => (
				<a class="story-row" href={tool.gardenHref}>
					<div class:list={['story-thumb', tones[i % tones.length]]}>
						{monogram(tool.repo)}
					</div>
					<div class="story-body">
						<div class="idea-head">
							<h3>{tool.repo}</h3>
							<span class="live-badge">live</span>
						</div>
						<p>{tool.description}</p>
						<div class="story-meta">
							<span class="badge">browser · garden note</span>
						</div>
					</div>
				</a>
			))}
		</div>
	</section>

	{sections.map((section) => (
		<section class="grid-section">
			<div class="section-head">
				<h2>{section.title}</h2>
			</div>
			<p class="section-blurb">{section.blurb}</p>
			<div class="story-grid">
				{section.ideas.map((idea, i) => (
					<a
						class="story-row"
						href={ideaHref(idea)}
						target="_blank"
						rel="noopener noreferrer"
					>
						<div class:list={['story-thumb', tones[i % tones.length]]}>
							{monogram(idea.repo)}
						</div>
						<div class="story-body">
							<div class="idea-head">
								<h3>{idea.repo}</h3>
								<span class="soon-badge">soon</span>
							</div>
							<p>{idea.desc}</p>
							<div class="story-meta">
								<span class="badge">{idea.type}</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	))}

	<style>
		.section-blurb {
			color: var(--muted);
			margin: -0.5rem 0 1.35rem;
			max-width: 65ch;
		}

		.idea-head {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 0.75rem;
		}

		.idea-head h3 {
			margin: 0;
		}

		.soon-badge {
			flex-shrink: 0;
			font-size: 0.68rem;
			font-weight: 650;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: #8a6a1f;
			background: rgba(196, 149, 48, 0.14);
			border: 1px solid rgba(196, 149, 48, 0.28);
			border-radius: 4px;
			padding: 0.12rem 0.45rem;
		}

		.live-badge {
			flex-shrink: 0;
			font-size: 0.68rem;
			font-weight: 650;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--accent);
			background: var(--accent-soft);
			border: 1px solid rgba(47, 107, 58, 0.28);
			border-radius: 4px;
			padding: 0.12rem 0.45rem;
		}
	</style>
</BaseLayout>
